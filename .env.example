APP_PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Optional: comma-separated WA group IDs (e.g. 120xxx@g.us,120yyy@g.us). Empty = allow all groups.
ALLOWED_GROUP_IDS=

# Optional: set Chrome/Chromium path if Puppeteer cannot auto-detect browser.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox

# Optional: force a specific WhatsApp Web version (important when upstream WA changes break whatsapp-web.js).
# WA_WEB_VERSION=2.3000.1017054665
# WA_WEB_VERSION_REMOTE_PATH=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/{version}.html

# Optional: Python integration paths for WhatsApp commands (/status, /report)
# PYTHON_PATH=python3
# STATUS_PYTHON_PATH=/path/to/python3
# STATUS_SCRIPT_PATH=/path/to/get_status_report.py
# STATUS_IMAGE_PATH=/path/to/dashboard_report.png
# REPORT_PYTHON_PATH=/path/to/python3
# REPORT_SCRIPT_PATH=/path/to/get_success_report.py
# REPORT_PROJECT_ROOT=/path/to/python/project/root
